#!/usr/bin/env bash
set -euo pipefail

portable=false
if [[ $# -eq 1 && "$1" == "--portable" ]]; then
  portable=true
elif [[ $# -ne 0 ]]; then
  echo "usage: $0 [--portable]" >&2
  exit 2
fi

if [[ "$portable" == false ]] || command -v aarch64-linux-gnu-gcc >/dev/null; then
  cargo build --locked --release --target aarch64-unknown-linux-gnu \
    --all-features \
    -p vehicle-runtime -p vehicle-diagnostics -p vehicle-ui -p sync
else
  echo "skipping ARM64 link: aarch64-linux-gnu-gcc is unavailable"
fi

cargo build --locked --release --target thumbv7em-none-eabihf --all-features -p duct-controller
