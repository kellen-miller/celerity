{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://celerity.dev/contracts/model/v1/manifest.schema.json",
  "title": "Celerity model bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "onnx_sha256",
    "signal_order",
    "units",
    "sample_period_ms",
    "history_length",
    "horizons",
    "output_order",
    "command_lattice",
    "compatibility",
    "input_ranges",
    "calibration_error",
    "normalization"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "onnx_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signal_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "sample_period_ms": { "type": "integer", "minimum": 1 },
    "history_length": { "type": "integer", "minimum": 1 },
    "horizons": { "const": [1] },
    "output_order": { "const": ["coolant", "post_intercooler_iat"] },
    "command_lattice": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 10000 },
      "minItems": 1,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "required": ["model_abi", "input_shape"],
      "properties": {
        "model_abi": { "type": "string", "minLength": 1 },
        "input_shape": {
          "type": "array",
          "prefixItems": [{ "const": 1 }, { "type": "integer", "minimum": 2 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "input_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum", "maximum"],
        "properties": {
          "minimum": { "type": "number" },
          "maximum": { "type": "number" }
        }
      }
    },
    "calibration_error": { "type": "number", "minimum": 0 },
    "normalization": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mean", "scale"],
        "properties": {
          "mean": { "type": "number" },
          "scale": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
