#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "check-systemd requires Linux" >&2
  exit 2
fi
if ! command -v systemctl >/dev/null || ! systemctl show-environment >/dev/null; then
  echo "host systemd is unavailable" >&2
  exit 1
fi
sudo -n true

for interface in vcan-powertrain vcan-controller; do
  ip link show "$interface" >/dev/null
done

unit_root=/run/systemd/system
runtime_override_root="$unit_root/celerityd.service.d"
tmpfiles_config=/run/tmpfiles.d/celerity.conf
config_root=/etc/celerity
state_root=/var/lib/celerity
runtime_binary=/usr/local/bin/celerityd
ctl_binary=/usr/local/bin/celerityctl
sync_binary=/usr/local/bin/celerity-sync
ui_binary=/usr/local/bin/celerity-ui
build_root=${CARGO_TARGET_DIR:-target}
check_root=$(mktemp -d)
diagnostics_group_created=false
ui_user_created=false
nonmember_user_created=false
state_root_created=false
port_holder_pid=

for path in \
  "$unit_root/celerityd.service" \
  "$unit_root/celerity-sync.service" \
  "$unit_root/celerity-ui.service" \
  "$tmpfiles_config" \
  "$runtime_binary" \
  "$ctl_binary" \
  "$sync_binary" \
  "$ui_binary" \
  "$config_root" \
  "$state_root"; do
  if sudo test -e "$path"; then
    echo "check-systemd refuses to overwrite existing path: $path" >&2
    exit 1
  fi
done

cleanup() {
  if [[ -n "$port_holder_pid" ]]; then
    kill "$port_holder_pid" >/dev/null 2>&1 || true
  fi
  sudo systemctl stop celerity-ui.service celerityd.service celerity-sync.service \
    >/dev/null 2>&1 || true
  sudo systemctl reset-failed celerity-ui.service celerityd.service celerity-sync.service \
    >/dev/null 2>&1 || true
  sudo rm -f \
    "$unit_root/celerityd.service" \
    "$unit_root/celerity-sync.service" \
    "$unit_root/celerity-ui.service" \
    "$runtime_override_root/10-supervisor-check.conf" \
    "$tmpfiles_config"
  sudo rmdir "$runtime_override_root" >/dev/null 2>&1 || true
  sudo rmdir /run/tmpfiles.d >/dev/null 2>&1 || true
  sudo rm -f "$runtime_binary" "$ctl_binary" "$sync_binary" "$ui_binary"
  sudo rm -f "$config_root/celerity.toml" "$config_root/home-token"
  sudo rmdir "$config_root" >/dev/null 2>&1 || true
  sudo rmdir /run/celerity >/dev/null 2>&1 || true
  if [[ "$state_root_created" == true ]]; then
    sudo rm -rf "$state_root"
  fi
  sudo systemctl daemon-reload
  if [[ "$nonmember_user_created" == true ]]; then
    sudo userdel celerity-no-diagnostics
  fi
  if [[ "$ui_user_created" == true ]]; then
    sudo userdel celerity-ui
  fi
  if [[ "$diagnostics_group_created" == true ]]; then
    sudo groupdel celerity-diagnostics
  fi
  rm -rf "$check_root"
}
trap cleanup EXIT

if ! getent group celerity-diagnostics >/dev/null; then
  sudo groupadd --system celerity-diagnostics
  diagnostics_group_created=true
fi
if ! id celerity-ui >/dev/null 2>&1; then
  sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
    --gid celerity-diagnostics celerity-ui
  ui_user_created=true
fi
if ! id celerity-no-diagnostics >/dev/null 2>&1; then
  sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
    celerity-no-diagnostics
  nonmember_user_created=true
fi
if id -nG celerity-no-diagnostics | tr ' ' '\n' | grep -Fx celerity-diagnostics; then
  echo "nonmember test identity belongs to celerity-diagnostics" >&2
  exit 1
fi

cargo build --release \
  -p vehicle-runtime -p vehicle-diagnostics -p vehicle-ui -p sync
sudo install -m 0755 "$build_root/release/celerityd" "$runtime_binary"
sudo install -m 0755 "$build_root/release/celerityctl" "$ctl_binary"
sudo install -m 0755 "$build_root/release/celerity-sync" "$sync_binary"
sudo install -m 0755 "$build_root/release/celerity-ui" "$ui_binary"
systemd-analyze verify \
  deploy/systemd/celerityd.service \
  deploy/systemd/celerity-sync.service \
  deploy/systemd/celerity-ui.service
sudo install -d -m 0755 "$config_root"
sudo install -m 0600 /dev/null "$config_root/home-token"
sudo install -m 0644 deploy/systemd/celerityd.service "$unit_root/celerityd.service"
sudo install -m 0644 deploy/systemd/celerity-sync.service "$unit_root/celerity-sync.service"
sudo install -m 0644 deploy/systemd/celerity-ui.service "$unit_root/celerity-ui.service"
sudo install -d -m 0755 /run/tmpfiles.d
sudo install -m 0644 deploy/tmpfiles.d/celerity.conf "$tmpfiles_config"
sudo systemd-tmpfiles --create "$tmpfiles_config"
sudo install -m 0644 config/examples/simulation.toml "$config_root/celerity.toml"
sudo install -d -m 0755 "$runtime_override_root"
sudo tee "$runtime_override_root/10-supervisor-check.conf" >/dev/null <<'EOF'
[Service]
ExecStart=
ExecStart=/usr/local/bin/celerityd --systemd-supervisor-check
EOF
state_root_created=true
sudo install -d -m 0700 -o root -g root "$state_root"
sudo systemctl daemon-reload

sudo systemctl start celerity-sync.service celerityd.service
sudo systemctl is-active --quiet celerity-sync.service
sudo systemctl is-active --quiet celerityd.service
[[ "$(sudo stat -c '%a %U %G' "$state_root")" == "700 root root" ]]
sudo systemctl stop celerityd.service celerity-sync.service

sudo systemctl start celerityd.service celerity-sync.service
sudo systemctl is-active --quiet celerityd.service
sudo systemctl is-active --quiet celerity-sync.service
[[ "$(sudo stat -c '%a %U %G' "$state_root")" == "700 root root" ]]

main_pid=$(sudo systemctl show celerityd.service --property MainPID --value)
restart_count=$(sudo systemctl show celerityd.service --property NRestarts --value)
sudo kill -KILL "$main_pid"
for _ in {1..30}; do
  current_count=$(sudo systemctl show celerityd.service --property NRestarts --value)
  if (( current_count > restart_count )); then
    break
  fi
  sleep 0.2
done
for _ in {1..30}; do
  if sudo systemctl is-active --quiet celerityd.service; then
    break
  fi
  sleep 0.2
done
sudo systemctl is-active --quiet celerityd.service
sudo systemctl status celerityd.service --no-pager \
  | grep -F "test-only supervisor check; no vehicle authority"

start_ns=$(date +%s%N)
sudo systemctl stop celerityd.service
end_ns=$(date +%s%N)
if (( end_ns - start_ns > 3000000000 )); then
  echo "celerityd exceeded bounded stop deadline" >&2
  exit 1
fi
[[ "$(sudo systemctl show celerityd.service --property Result --value)" == "success" ]]
sudo systemctl stop celerity-sync.service
sudo tee "$runtime_override_root/10-supervisor-check.conf" >/dev/null <<'EOF'
[Service]
ExecStart=
ExecStart=/usr/local/bin/celerityd --systemd-vcan-check /etc/celerity/celerity.toml
EOF

sudo tee "$config_root/celerity.toml" >/dev/null <<'EOF'
schema_version = 1
generation = 1
mode = "live"

[runtime]
cycle_ms = 20
input_stale_after_ms = 250
model_signals_stale_after_ms = 250
controller_truth_stale_after_ms = 80

[powertrain]
decoder_generation = 1

[powertrain.cantcu]
mode = "disabled"

[controllers.duct]
address = 1
identity = 1
configuration_generation = 1
capability_generation = 1
resource_id = 1
minimum_basis_points = 0
maximum_basis_points = 10000
maximum_command_rate_hz = 50
fallback_basis_points = 9000
pwm_endpoint_a_us = 1000
pwm_endpoint_b_us = 2000
direction = 1
runtime_lease_ms = 100
command_lease_ms = 50
heartbeat_period_ms = 20
acknowledgement_deadline_ms = 25
normal_slew_basis_points_per_second = 1000
protection_slew_basis_points_per_second = 2000
digest_prefix = 1

[duct]
radiator_split_minimum = 0.1
radiator_split_maximum = 0.9
coolant_breakpoints_c = [80.0, 95.0, 105.0]
iat_breakpoints_c = [30.0, 50.0, 70.0]
policy_basis_points = [[1000, 2000, 3000], [4000, 5000, 6000], [7000, 8000, 9000]]

[model]
required = false
slots_root = "/var/lib/celerity/models"
abi = "thermal-v1"
input_signals = ["coolant_temperature_c", "air_temperature_c"]
history_length = 1
warmup_iterations = 1
maximum_uncertainty = 0.1
maximum_ood_score = 0.1
required_post_work_ns = 1
hard_coolant_ceiling_c = 110.0
coolant_target_c = 80.0
coolant_input_minimum_c = 60.0
coolant_input_maximum_c = 120.0
iat_input_minimum_c = 0.0
iat_input_maximum_c = 100.0
command_lattice = [1000, 5000, 9000]

[run_storage]
root = "/var/lib/celerity/runs"
minimum_free_bytes = 1

[diagnostics]
socket = "/run/celerity/diagnostics.sock"

[sync]
spool_root = "/var/lib/celerity/runs"
retention_count = 2
incomplete_retention_count = 2
home_interface = "home0"
expected_default_gateway = "192.0.2.1"
home_api_url = "https://home.invalid"
credential_path = "/etc/celerity/home-token"

[composition]
kind = "live"
powertrain_interface = "vcan-powertrain"
actuator_interface = "vcan-controller"
watchdog = true
EOF
sudo systemctl daemon-reload

sudo systemctl start celerity-sync.service celerityd.service
sudo systemctl is-active --quiet celerity-sync.service
sudo systemctl is-active --quiet celerityd.service
[[ "$(sudo stat -c '%a %U %G' "$state_root")" == "700 root root" ]]
sudo systemctl stop celerityd.service celerity-sync.service

run_file=$(sudo find "$state_root/runs" -type f -print -quit)
if [[ -z "$run_file" ]]; then
  echo "real runtime did not produce a Run file" >&2
  exit 1
fi
if sudo -u celerity-ui head -c 1 "$run_file" 2>"$check_root/ui-run-error" \
  | tee "$check_root/ui-run-read" >/dev/null; then
  echo "celerity-ui unexpectedly read a Run file" >&2
  exit 1
fi
grep -F "Permission denied" "$check_root/ui-run-error"

sudo systemctl start celerityd.service celerity-sync.service
sudo systemctl is-active --quiet celerityd.service
sudo systemctl is-active --quiet celerity-sync.service
[[ "$(sudo stat -c '%a %U %G' "$state_root")" == "700 root root" ]]
for _ in {1..50}; do
  if sudo test -S /run/celerity/diagnostics.sock; then
    break
  fi
  sleep 0.1
done
[[ "$(sudo stat -c '%a %U %G' /run/celerity)" == "750 root celerity-diagnostics" ]]
[[ "$(sudo stat -c '%a %U %G' /run/celerity/diagnostics.sock)" == \
  "660 root celerity-diagnostics" ]]

if sudo -u celerity-no-diagnostics "$ctl_binary" status \
  --socket /run/celerity/diagnostics.sock 2>"$check_root/nonmember-error" \
  | tee "$check_root/nonmember-status" >/dev/null; then
  echo "nonmember unexpectedly read diagnostics" >&2
  exit 1
fi
grep -F "Permission denied" "$check_root/nonmember-error"
sudo -u celerity-ui -g celerity-diagnostics "$ctl_binary" status \
  --socket /run/celerity/diagnostics.sock \
  | tee "$check_root/member-status" >/dev/null
python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["schema_version"] == 2' \
  "$check_root/member-status"

sudo systemctl start celerity-ui.service
for _ in {1..50}; do
  if curl --max-time 1 -fsS -H 'Host: localhost:8080' \
    http://127.0.0.1:8080/v1/status >"$check_root/status.json" \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["state"] == "current"' \
      "$check_root/status.json"; then
    break
  fi
  sleep 0.2
done
python3 -c 'import json,sys; value=json.load(open(sys.argv[1])); assert value["state"] == "current"; assert value["snapshot"] is not None' \
  "$check_root/status.json"
sudo systemctl is-active --quiet celerity-ui.service

ui_properties=$(sudo systemctl show celerity-ui.service \
  --property User \
  --property Group \
  --property NoNewPrivileges \
  --property PrivateDevices \
  --property PrivateTmp \
  --property ProtectSystem \
  --property ProtectHome \
  --property RestrictAddressFamilies \
  --property CapabilityBoundingSet)
grep -Fx 'User=celerity-ui' <<<"$ui_properties"
grep -Fx 'Group=celerity-diagnostics' <<<"$ui_properties"
grep -Fx 'NoNewPrivileges=yes' <<<"$ui_properties"
grep -Fx 'PrivateDevices=yes' <<<"$ui_properties"
grep -Fx 'PrivateTmp=yes' <<<"$ui_properties"
grep -Fx 'ProtectSystem=strict' <<<"$ui_properties"
grep -Fx 'ProtectHome=yes' <<<"$ui_properties"
grep -Fx 'CapabilityBoundingSet=' <<<"$ui_properties"
grep -F 'AF_UNIX' <<<"$ui_properties"
grep -F 'AF_INET' <<<"$ui_properties"
sudo systemctl cat celerity-ui.service | grep -Fx 'IPAddressDeny=any'
sudo systemctl cat celerity-ui.service | grep -Fx 'IPAddressAllow=localhost'
sudo systemctl cat celerity-ui.service \
  | grep -Fx 'InaccessiblePaths=-/etc/celerity -/var/lib/celerity'

listeners=$(ss -ltnH 'sport = :8080')
[[ "$(wc -l <<<"$listeners")" -eq 1 ]]
grep -F '127.0.0.1:8080' <<<"$listeners"
if grep -F '[::]' <<<"$listeners"; then
  echo "celerity-ui exposed a non-loopback listener" >&2
  exit 1
fi

runtime_pid=$(sudo systemctl show celerityd.service --property MainPID --value)
runtime_restarts=$(sudo systemctl show celerityd.service --property NRestarts --value)
sudo systemctl stop celerity-ui.service
sudo systemctl is-active --quiet celerityd.service
[[ "$(sudo systemctl show celerityd.service --property MainPID --value)" == \
  "$runtime_pid" ]]
[[ "$(sudo systemctl show celerityd.service --property NRestarts --value)" == \
  "$runtime_restarts" ]]

sudo systemctl start celerity-ui.service
sudo systemctl is-active --quiet celerity-ui.service
sudo systemctl stop celerityd.service
sudo systemctl is-active --quiet celerity-ui.service
for _ in {1..30}; do
  if curl --max-time 1 -fsS -H 'Host: localhost:8080' \
    http://127.0.0.1:8080/v1/status >"$check_root/unavailable.json" \
    && python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["state"] == "unavailable"' \
    "$check_root/unavailable.json"; then
    break
  fi
  sleep 0.2
done
python3 -c 'import json,sys; value=json.load(open(sys.argv[1])); assert value["state"] == "unavailable"; assert value["snapshot"] is None' \
  "$check_root/unavailable.json"

sudo systemctl stop celerity-ui.service
python3 -m http.server 8080 --bind 127.0.0.1 \
  >"$check_root/port-holder.log" 2>&1 &
port_holder_pid=$!
for _ in {1..20}; do
  if curl --max-time 1 -fsS http://127.0.0.1:8080/ >/dev/null; then
    break
  fi
  sleep 0.1
done
sudo systemctl start celerity-ui.service || true
for _ in {1..60}; do
  if [[ "$(sudo systemctl show celerity-ui.service --property ActiveState --value)" == \
    "failed" ]]; then
    break
  fi
  sleep 0.2
done
[[ "$(sudo systemctl show celerity-ui.service --property ActiveState --value)" == \
  "failed" ]]
ui_restarts=$(sudo systemctl show celerity-ui.service --property NRestarts --value)
if (( ui_restarts > 3 )); then
  echo "celerity-ui exceeded its restart bound: $ui_restarts" >&2
  exit 1
fi

kill "$port_holder_pid"
wait "$port_holder_pid" 2>/dev/null || true
port_holder_pid=
sudo systemctl reset-failed celerity-ui.service celerityd.service
sudo systemctl stop celerityd.service
if [[ "$ui_user_created" == true ]]; then
  sudo userdel celerity-ui
  ui_user_created=false
fi
if [[ "$diagnostics_group_created" == true ]]; then
  sudo groupdel celerity-diagnostics
  diagnostics_group_created=false
fi
sudo rm -f "$tmpfiles_config"
sudo rmdir /run/celerity >/dev/null 2>&1 || true
if getent group celerity-diagnostics >/dev/null || sudo test -e /run/celerity; then
  echo "viewer group or runtime provisioning survived independence setup" >&2
  exit 1
fi

sudo systemctl start celerityd.service
for _ in {1..50}; do
  if sudo systemctl is-active --quiet celerityd.service \
    && sudo test -S /run/celerity/diagnostics.sock; then
    break
  fi
  sleep 0.1
done
sudo systemctl is-active --quiet celerityd.service
[[ "$(sudo stat -c '%a %U %G' /run/celerity)" == "750 root root" ]]
[[ "$(sudo stat -c '%a %U %G' /run/celerity/diagnostics.sock)" == \
  "660 root root" ]]
sudo "$ctl_binary" status --socket /run/celerity/diagnostics.sock \
  | tee "$check_root/no-viewer-provisioning-status" >/dev/null
python3 -c 'import json,sys; assert json.load(open(sys.argv[1]))["schema_version"] == 2' \
  "$check_root/no-viewer-provisioning-status"
echo "celerityd no-viewer-provisioning: runtime=750 root:root socket=660 root:root"
sudo systemctl stop celerityd.service
if sudo test -e /run/celerity; then
  echo "celerityd did not remove its unit-owned runtime directory" >&2
  exit 1
fi
