#!/usr/bin/env bash
set -euo pipefail

# Install before the acceptance test starts its bounded server-readiness wait.
uv sync --project services/home --locked

# Keep workspace feature unification identical to the preceding workspace tests.
# model_slots and the home application are covered by their full test suites.
cargo test --locked --workspace --all-features --test end_to_end -- --ignored --nocapture
