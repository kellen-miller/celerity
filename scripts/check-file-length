#!/usr/bin/env bash
set -euo pipefail

readonly max_lines=500
violations=0

while IFS= read -r -d '' file_path; do
  case "$file_path" in
    */package-lock.json) continue ;;
    */generated/*) continue ;;
    *.rs|*.py|*.ts|*.tsx|*.js|*.jsx|*.svelte|*.css|*.html|*.proto|*.sh|*.bash|*.yaml|*.yml|*.toml|*.json|*.service|*.conf|Dockerfile|*/Dockerfile|scripts/*) ;;
    *) continue ;;
  esac

  lines=$(wc -l < "$file_path")
  if (( lines > max_lines )); then
    printf 'file exceeds %d lines: %s (%d)\n' "$max_lines" "$file_path" "$lines" >&2
    violations=$((violations + 1))
  fi
done < <(git ls-files --cached --others --exclude-standard -z)

if (( violations > 0 )); then
  exit 1
fi
