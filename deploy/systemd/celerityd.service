[Unit]
Description=Celerity vehicle control runtime
After=local-fs.target
RequiresMountsFor=/var/lib/celerity
StartLimitIntervalSec=30
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
Group=root
ExecStartPre=+/usr/bin/chown root:root /var/lib/celerity
ExecStartPre=+/usr/bin/chmod 0700 /var/lib/celerity
ExecStart=/usr/local/bin/celerityd /etc/celerity/celerity.toml
ExecStartPost=+/usr/bin/chown root:root /var/lib/celerity
ExecStartPost=+/usr/bin/chmod 0700 /var/lib/celerity
ExecStartPost=-+/usr/bin/chown root:celerity-diagnostics /run/celerity /run/celerity/diagnostics.sock
Environment=CELERITY_DIAGNOSTICS_SOCKET=/run/celerity/diagnostics.sock
RuntimeDirectory=celerity
RuntimeDirectoryMode=0750
StateDirectory=celerity
StateDirectoryMode=0700
WatchdogSec=2s
TimeoutStopSec=3s
Restart=on-failure
RestartSec=1s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/celerity /run/celerity

[Install]
WantedBy=multi-user.target
