#!/usr/bin/env bash
set -euo pipefail

# Avoid the Azure archive mirror that can stall hosted runner downloads.
sudo find /etc/apt -type f \( -name '*.list' -o -name '*.sources' -o -name 'apt-mirrors.txt' \) \
  -exec sed -i -E 's|https?://azure[.]archive[.]ubuntu[.]com/ubuntu|https://archive.ubuntu.com/ubuntu|g' {} +
